<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -MultiViews
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 "Page not found. Please enable mod_rewrite / URL rewriting."
</IfModule>

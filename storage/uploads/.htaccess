<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|shtml|cgi)$">
    Require all denied
</FilesMatch>

# Disable all handlers for PHP files
AddHandler default-handler .php .phtml .php3 .php4 .php5 .php7 .php8

# Deny access to all files that might be used as shells
<FilesMatch "\.(exe|sh|bat|cmd|pl|cgi|py)$">
    Require all denied
</FilesMatch>
